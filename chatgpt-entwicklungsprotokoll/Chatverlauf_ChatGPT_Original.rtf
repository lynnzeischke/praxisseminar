\f1\b\fs48 \cf5 \cb6 DR-20 \'96 Zielpopulation und Anwendungskontext m\'fcssen ber\'fccksichtigt werden
\f0\b0\fs32 \cf4 \
\pard\pardeftab720\sl520\partightenfactor0
\cf5 Die Studien verwenden jeweils klar abgegrenzte Zielgruppen: Besch\'e4ftigte, F\'fchrungskr\'e4fte, Patientengruppen usw. \cf4 \
\cf5 Deshalb:\cf4 \
\cf5 Items m\'fcssen sprachlich, fachlich und inhaltlich f\'fcr die definierte Zielpopulation beantwortbar sein.\cf4 \
\cf5 F\'fcr deine KI-Readiness-Messung w\'e4re beispielsweise eine Aussage wie\cf4 \
\cf5 \'84Ich verstehe den Attention-Mechanismus transformerbasierter Large Language Models.\'93\cf4 \
\cf5 f\'fcr normale Mitarbeitende als allgemeines Readiness-Item fragw\'fcrdig.\cf4 \
\cf5 Besser w\'e4re gegebenenfalls:\cf4 \
\cf5 \'84Ich kann grundlegende Funktionsweisen und Grenzen der von mir eingesetzten KI-Anwendungen erkl\'e4ren.\'93\cf4 \

\f1\b \cf5 Priorit\'e4t:
\f0\b0  MUST.\cf4 \
\pard\pardeftab720\sl520\sa160\qc\partightenfactor0
